# Reference list of backend variables. Export these in your shell or set them
# in your deployment platform; Docker Compose passes them through from the
# environment. A local run also reads a .env file.
# Never commit real values.

# --- App ---
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# PostGIS is not part of docker-compose.yml. When running the backend in
# Docker, set DATABASE_URL in the root .env (or shell) to an address the
# container can reach, e.g.
# postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/work_near
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/work_near

# --- Email ---
# SMTP is the fallback. Set BREVO_ENABLED=true to send through the Brevo
# transactional email API instead; SMTP_FROM_EMAIL must then be a verified
# Brevo sender.
BREVO_ENABLED=false
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_TIMEOUT_SECONDS=30

# SMTP fallback (ZeptoMail by default).
# SMTP_USERNAME is the literal string "emailapikey" for ZeptoMail.
# SMTP_PASSWORD is the Send Mail token from the ZeptoMail agent.
# SMTP_FROM_EMAIL must be on a domain verified with the active provider.
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_START_TLS=true
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=
SMTP_FROM_NAME=Reach
SMTP_FROM_EMAIL=no-reply@your-verified-domain.com

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FossaPay ---
# Local development: use the fake provider. No live money moves.
FOSSAPAY_ENABLED=false
PAYMENT_PROVIDER=fake

# Production:
# FOSSAPAY_ENABLED=true
# PAYMENT_PROVIDER=fossapay
# FOSSAPAY_API_KEY=fk_production_...
FOSSAPAY_API_URL=https://api-production.fossapay.com/api/v1
FOSSAPAY_API_KEY=
FOSSAPAY_WEBHOOK_SECRET=
FOSSAPAY_TIMEOUT_SECONDS=30

# --- Payments ---
# 5% commission, deducted from the provider payout.
PLATFORM_FEE_BPS=500
# Minimum escrow: 100000 kobo = NGN 1,000.
MIN_ESCROW_KOBO=100000

# --- Obiex (fiat collection, NGN <-> USDC, crypto withdrawals) ---
OBiex_ENABLED=false
OBiex_API_URL=https://api.obiex.finance/v1
# Staging: https://staging.api.obiex.finance/v1
OBiex_API_KEY=
OBiex_API_SECRET=
OBiex_WEBHOOK_SECRET=
OBiex_TIMEOUT_SECONDS=30
# The stablecoin collections settle into.
OBiex_COLLECTION_CURRENCY=USDC
# The network the treasury's USDC is withdrawn on.
OBiex_WITHDRAWAL_NETWORK=SOL

# --- Solana (Model 1 settlement layer) ---
# The relayer's RPC endpoint. Mainnet or devnet.
REACH_SOLANA_RPC_URL=
# Path to the Anchor IDL. Defaults to ../sol-contract/idl.json in the repo.
REACH_ANCHOR_IDL_PATH=
REACH_PROGRAM_ID=5iCtrxFDsPQf6qyR2nfjkDgUJyuH7oxoA5Lf1qQiDfwY
# The SPL stablecoin the escrow holds (mainnet USDC).
REACH_STABLE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# The relayer's Solana secret key, base58. It signs create_task, accept and
# approve_work on behalf of custodial payers. Keep it out of git.
REACH_RELAYER_SECRET_KEY=
REACH_RELAYER_CONFIRM_TIMEOUT=60
# Smallest escrow the relayer will lock, in USDC base units (1 USDC).
REACH_MIN_ESCROW_UNITS=1000000
# The program's creation fee, in basis points (2.5%). The backend leaves room
# for it when it works out how much escrow the funded amount can cover.
REACH_CREATION_FEE_BPS=250
# The `expires_at` written into a provider's on-chain application, in seconds
# (7 days). The program records it; the backend uses it as the application TTL.
REACH_APPLICATION_TTL_SECONDS=604800
# The USDC float the treasury keeps on Solana with the relayer, in base units
# (6 decimals). 500 USDC.
REACH_TREASURY_TARGET_UNITS=500000000
# Obiex's minimum withdrawal, in base units. 10 USDC.
REACH_TREASURY_MIN_WITHDRAWAL_UNITS=10000000

# --- Provider naira off-ramp (USDC -> NGNX -> bank) ---
# Keep this false until the Obiex prerequisites in
# docs/REACH_NAIRA_OFFRAMP.md are confirmed and a staging run has passed.
REACH_OFFRAMP_ENABLED=false
REACH_OFFRAMP_SOURCE_CURRENCY=USDC
REACH_OFFRAMP_TARGET_CURRENCY=NGNX
REACH_OFFRAMP_NETWORK=SOL
REACH_OFFRAMP_FALLBACK_CURRENCY=USDT
# 5 USDC minimum, 1,000 USDC maximum per request.
REACH_OFFRAMP_MIN_USDC_UNITS=5000000
REACH_OFFRAMP_MAX_USDC_UNITS=1000000000
# NGN 5,000 minimum payout.
REACH_OFFRAMP_MIN_NGN_KOBO=500000
# The provider has 30 minutes to send the USDC.
REACH_OFFRAMP_DEPOSIT_TTL_SECONDS=1800
REACH_OFFRAMP_QUOTE_TTL_SECONDS=300
# Hold the payout if the executed rate is 2% below the quote.
REACH_OFFRAMP_SLIPPAGE_BPS=200
# Quote-time fee estimate. The live fee from Obiex wins.
REACH_OFFRAMP_FIAT_FEE_KOBO=5000
REACH_OFFRAMP_REQUIRE_NAME_MATCH=true
