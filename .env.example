# Copy to .env for Docker Compose. Never commit .env.
# Backend settings (secrets, mail, Cloudinary, providers) live in
# backend/.env; values in this file are also passed to the backend container
# and override backend/.env.

# --- Database ---
# PostGIS must already be running. Use an address the backend container can
# reach: host.docker.internal for a database on your host, or the service
# name for a database in another Compose project.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/work_near

# --- Published ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---
# Baked into the browser bundle at build time. Use a URL the browser can
# reach, not the Compose service name.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NOMINATIM_EMAIL=contact@example.com
